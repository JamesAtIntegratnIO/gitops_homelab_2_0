{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "kargo-pipelines values",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "git"
  ],
  "properties": {
    "nameLabel": {
      "type": "string"
    },
    "git": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repoURL"
      ],
      "properties": {
        "repoURL": {
          "type": "string",
          "minLength": 1,
          "description": "Must match the Kargo git credential Secret's repoURL after normalisation."
        },
        "branch": {
          "type": "string",
          "minLength": 1
        },
        "provider": {
          "enum": [
            "github",
            "gitlab",
            "bitbucket",
            "gitea",
            "azure"
          ]
        },
        "insecureSkipTLSVerify": {
          "type": "boolean"
        }
      }
    },
    "merge": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "method": {
          "type": "string"
        },
        "pollInterval": {
          "type": "string"
        },
        "waitPollInterval": {
          "type": "string"
        },
        "errorThreshold": {
          "type": "integer",
          "minimum": 1
        },
        "timeout": {
          "type": "string",
          "pattern": "^\\d+h\\d+m\\d+s$|^\\d+m\\d+s$|^\\d+s$",
          "description": "Go canonical duration. Kargo's webhook rewrites non-canonical forms, which ArgoCD then reads as permanent drift."
        },
        "waitTimeout": {
          "type": "string",
          "pattern": "^\\d+h\\d+m\\d+s$|^\\d+m\\d+s$|^\\d+s$",
          "description": "Go canonical duration. Kargo's webhook rewrites non-canonical forms, which ArgoCD then reads as permanent drift."
        }
      }
    },
    "triage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "url": {
          "type": "string"
        },
        "when": {
          "enum": [
            "always",
            "gated",
            "never"
          ]
        },
        "continueOnError": {
          "type": "boolean"
        },
        "timeout": {
          "type": "string"
        }
      }
    },
    "defaults": {
      "type": "object"
    },
    "verification": {
      "type": "object"
    },
    "projects": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "targets": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "scope": {
                  "type": "string"
                },
                "image": {
                  "type": "object"
                },
                "chart": {
                  "type": "object"
                },
                "git": {
                  "type": "object"
                },
                "updates": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "file",
                      "keys"
                    ],
                    "properties": {
                      "file": {
                        "type": "string",
                        "minLength": 1
                      },
                      "keys": {
                        "type": "array",
                        "minItems": 1,
                        "items": {
                          "type": "string"
                        }
                      },
                      "format": {
                        "enum": [
                          "image",
                          "image-tag",
                          "tag",
                          "version"
                        ]
                      }
                    }
                  }
                },
                "stages": {
                  "type": "array",
                  "minItems": 2,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "name",
                      "updates"
                    ],
                    "properties": {
                      "name": {
                        "type": "string",
                        "minLength": 1,
                        "description": "Suffix for this stage's Kargo object. The LAST stage ignores it and keeps the target's bare name, preserving freight and verification history."
                      },
                      "updates": {
                        "type": "array",
                        "minItems": 1,
                        "items": {
                          "type": "object",
                          "additionalProperties": false,
                          "required": [
                            "file",
                            "keys"
                          ],
                          "properties": {
                            "file": {
                              "type": "string",
                              "minLength": 1
                            },
                            "keys": {
                              "type": "array",
                              "minItems": 1,
                              "items": {
                                "type": "string"
                              }
                            },
                            "format": {
                              "enum": [
                                "image",
                                "image-tag",
                                "tag",
                                "version"
                              ]
                            }
                          }
                        }
                      },
                      "verify": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "apps"
                        ],
                        "properties": {
                          "apps": {
                            "type": "array",
                            "minItems": 1,
                            "items": {
                              "type": "string"
                            }
                          }
                        }
                      },
                      "autoMerge": {
                        "enum": [
                          "always",
                          "minor",
                          "patch",
                          "never"
                        ]
                      },
                      "requiredSoakTime": {
                        "type": "string",
                        "pattern": "^\\d+h\\d+m\\d+s$|^\\d+m\\d+s$|^\\d+s$",
                        "description": "Go canonical duration. Kargo's webhook rewrites non-canonical forms, which ArgoCD then reads as permanent drift."
                      },
                      "autoPromotion": {
                        "type": "boolean",
                        "description": "Override the target's auto-promotion for this stage. Hold the terminal stage off while a new chain is being trusted."
                      }
                    }
                  },
                  "description": "Ordered promotion chain. Two or more; a single stage should be written as target-level `updates` instead."
                },
                "verify": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "apps"
                  ],
                  "properties": {
                    "apps": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                },
                "autoMerge": {
                  "enum": [
                    "always",
                    "minor",
                    "patch",
                    "never"
                  ]
                },
                "autoPromotion": {
                  "type": "boolean"
                },
                "autoRollback": {
                  "type": "boolean"
                },
                "interval": {
                  "type": "string"
                },
                "format": {
                  "enum": [
                    "image",
                    "image-tag",
                    "tag",
                    "version"
                  ]
                }
              }
            }
          },
          "autoRollback": {
            "type": "boolean"
          },
          "description": {
            "type": "string"
          }
        }
      }
    }
  }
}
